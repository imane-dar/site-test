<!DOCTYPE html>
<html lang="{{ lang }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ titre }}</title>
    <link rel="stylesheet" href="css/style.css">
</head>

<body>
    <header>
        <div class="logo">
        {% if lang == 'fr' %}
        <a href="index.php"> <img src="images/logo1.png" alt="Logo Cuisine du Monde"> </a>
        {% else %}
        <a href="index-en.php"> <img src="images/logo1.png" alt="Logo Cuisine du Monde"> </a>
        {% endif %}
        </div>
        <nav>
            {% if lang == 'fr' %}
            {# fichierss php fr #}
            <a href="index.php">Accueil</a>
            <a href="produit.php">Nos Produits</a>
            <a href="cuisine.php">Cuisines du Monde</a>
            <a href="recette.php">Recettes</a>
            <a href="apropos.php">À propos</a>
            <a href="contact.php">Contact</a>
            <a href="index-en.php"><b>EN</b></a>
            {% else %}
            {# fichiers php anglais #}
            <a href="index-en.php">Home</a>
            <a href="produit-en.php">Our Products</a>
            <a href="cuisine-en.php">World Cuisines</a>
            <a href="recette-en.php">Recipes</a>
            <a href="apropos-en.php">About Us</a>
            <a href="contact-en.php">Contact</a>
            <a href="index.php"><b>FR</b></a>
            {% endif %}
        </nav>
    </header>
    <main>
        {% block main %}
        <section class="banniere">
            <div class="btexte">
                <h1>{{titre_bienvenu}}</h1>
                <p>{{message_bienvenu}}</p>
                <p class="promo">
                    Code promo : <strong>{{ code }}</strong> <br>
                    – {{ reduction }}%
                </p>
                <a href="#" class="bouton">{{message}}</a>
            </div>
            <section class="image-banniere">
                <img src="{{ url_image }}" alt="{{ produit.alt_image }}">
            </section>
        </section>
        {% endblock %}
    </main>
    <footer>
        <div class="footer">
            <div class="footer-section">
                <h3>À propos</h3>
                <p>Découvrez nos produits de qualité et nos recettes du monde</p>
            </div>
            <div class="footer-section">
                <h3>Liens rapides</h3>
                <ul>
                    {% if lang == 'fr' %}
                    {# fichierss php fr #}
                    <li><a href="accueil.php">Accueil</a></li>
                    <li><a href="produit.php">Nos Produits</a></li>
                    <li><a href="cuisine.php">Cuisines du Monde</a></li>
                    <li><a href="recette.php">Recettes</a></li>
                    <li><a href="apropos.php">À propos</a></li>
                    <li><a href="contact.php">Contact</a></li>
                    <li><a href="accueil-en.php"> <b>EN</b></a></li>
                    {% else %}
                    {# fichiers php anglais #}
                    <li><a href="accueil-en.php">Home</a></li>
                    <li><a href="produit-en.php">Our Products</a></li>
                    <li><a href="cuisine-en.php">World Cuisines</a></li>
                    <li><a href="recette-en.php">Recipes</a></li>
                    <li><a href="apropos-en.php">About Us</a></li>
                    <li><a href="contact-en.php">Contact</a></li>
                    <li><a href="accueil.php"><b>FR</b></a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="footer-section">
                <h3>Contact</h3>
                <p>Email: cuisinedumonde@gmail.com</p>
                <p>Phone: +33 1 23 45 67 89</p>
            </div>
        </div>
        <div class="footer-fin">
            <p>&copy; 2026 Cuisines du Monde. Tous droits réservés.</p>
        </div>
    </footer>
</body>

</html>