{% extends "base.twig" %}

{% block main %}

<article class="apropos">
    <div class="infos">
        <h2>{{mission_titre}}</h2>
        <p>{{ mission|nl2br }}</p>
        <h2>{{choix_titre}}</h2>
        <p>{{ choix|nl2br }}</p>
        <h2>{{histoire_titre}}</h2>
        <p><i>{{ histoire|nl2br }}</i></p>
    </div>
    <div class="CGU">
        <h2>{{titre_cgu}}</h2>
        <ul>
            <li>{{ objetCGU }}</li>
            <li>{{ produitsCGU|nl2br }}</li>
            <li>{{ proprieteCGU }}</li>
            <li>{{ donneesCGU|nl2br }}</li>
            <li>{{ limitationCGU|nl2br }}</li>
        </ul>
    </div>
</article>

{% endblock %}
