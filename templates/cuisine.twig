{% extends "base.twig" %}

{% block main %}
 <nav class="submenu">
        <ul>
            {% for cuisine in cuisines %}
            <li><a href="#article-{{ cuisine.id }}">{{ cuisine.encre }}</a></li>
            {% endfor %}
        </ul>
    </nav>
<section class="cuisine">
    <div>
        {% for cuisine in cuisines %}
        <article id="article-{{ cuisine.id }}">
        <div class="article-cuisine">
            <div class="grille-images">
                {% for image in cuisine.url_image %}
                <img src="{{ image }}" alt="{{ cuisine }}">
                {% endfor %}
            </div>
            <div class="détails-cuisine">
                <h2>{{ cuisine.titre }}</h2>
                <p><strong>{{ cuisine.continent }}</strong></p>
                <p>{{ cuisine.infos }}</p>
                <p>{{ cuisine.détail }}</p>
            </div>
        </div>
        </article>
        {% endfor %}
    </div>
    <div>
        <aside class="aside-cuisine">
            <h3> {{ titre_aside }} </h3>
            <ul>
                <li><a target="_blank" href="https://www.pankaj-blog.com/category/plats-indiens/">{{aside_1}}</a></li>
                <li><a target="_blank" href="https://latavoladigael.com/les-recettes-italiennes/">{{aside_2}}</a></li>
                <li><a target="_blank" href="https://www.cuisineaz.com/cuisine-du-monde/maroc-p237">{{aside_3}}</a></li>
                <li><a target="_blank" href="https://macuisineturque.fr">{{aside_4}}</a></li>
                <li><a target="_blank" href="https://www.jevtobond.com/recettes-thai/">{{aside_5}}</a></li>
                <li><a target="_blank" href="https://www.italie-authentique.com/conseils-voyage/que-faire/10-lieux-a-ne-pas-rater-en-italie">{{aside_6}}</a></li>
                <li><a target="_blank" href="https://www.labalaguere.com/in/decouvrir-turquie">{{aside_7}}</a></li>
                <li><a target="_blank" href="https://www.decouvertedelinde.com">{{aside_8}}</a></li>
                <li><a target="_blank" href="https://www.visitmorocco.com/fr">{{aside_9}}</a></li>
                <li><a target="_blank" href="https://www.lonelyplanet.fr/article/10-choses-incontournables-faire-en-thailande">{{aside_10}}</a>
        </aside>
    </div>
</section>
{% endblock %}