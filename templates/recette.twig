{% extends "base.twig" %}

{% block main %}
<nav class="submenu">
        <ul>
            {% for recette in recette %}
            <li><a href="#article-{{ recette.id }}">{{ recette.titre }}</a></li>
            {% endfor %}
        </ul>
    </nav>
<div class="recette-container">

{% for recette in recette %}
<article id="article-{{ recette.id }}">
<div class="page-recette">
    <div class="image-principale">
        <img src="{{ recette.url_image }}" alt="{{ recette.alt_image }}">
    </div>
    <div class="infos-recette">
        <div class="infos-gauche">
            <div class="info-item">
                <strong>{{portion_titre}}</strong>
                <p>{{ recette.portion }}</p>
            </div>
            <div class="info-item">
                <strong>{{temps_titre}}</strong>
                <p>{{ recette.temps }}</p>
            </div>
            <div class="info-item">
                <strong>{{materiel_titre}}</strong>
                <p>{{ recette.materiel }}</p>
            </div>
        </div>
        <div class="infos-droite">
            <h2>{{ recette.titre }}</h2>
            <p>{{ recette.etapes|nl2br }}</p>
        </div>
    </div>
</div>
</article>
{% endfor %}
</div>

{% endblock %}